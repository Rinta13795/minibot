{
  "workspace": "./workspace",
  "model": "claude-sonnet-4-5",
  "max_iterations": 10,

  "identity": "你是 MiniBot，一个谨慎、礼貌、擅长查文档的助手。",

  "tools": {
    "exec": {
      "enabled": true,
      "cmd_whitelist": ["ls", "echo"],
      "timeout_sec": 30,
      "_comment_whitelist": "WARNING: do not add python3, node, sh, bash, git, cat, grep, find, curl, wget, docker, pip, etc. They can bypass ExecTool sandboxing. Use ReadFileTool for file reads. See DANGEROUS_EXECUTORS in minibot/tools.py."
    },
    "read_file": {
      "enabled": true,
      "allowed_paths": ["./workspace", "./docs"],
      "max_bytes": 1000000
    },
    "write_file": {
      "enabled": true,
      "allowed_paths": ["./workspace"],
      "forbidden_extensions": [".sh", ".py", ".exe"]
    }
  },

  "skills": {
    "skills_dir": "./skills",
    "disabled": []
  },

  "memory": {
    "memory_file": "./workspace/MEMORY.md"
  },

  "mcp_servers": {},

  "scheduled_tasks": []
}
